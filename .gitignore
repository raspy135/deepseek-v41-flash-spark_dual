__pycache__/
*.pyc
*.pyo
.DS_Store
.venv/
logs/
engram_rows/

# The checkpoint is 510 GB and lives here by default. Never in git.
models/

# Local configuration: this is where the box-specific values go (MODEL_DIR,
# PYTHON, HF_TOKEN, ...). env.example is the tracked, generic template.
.env
*.env
!env.example

# results/ is mostly tracked -- the measured rows ARE the deliverable -- with
# two exceptions that are big and regenerable:
#   * results/*/trace/*.npz  the raw per-layer routing trace (tools/expert_trace.py)
#   * results/*/state/       the tracer's resume state
# What the server itself needs is results/*/stats/coverage.json, and that stays
# tracked. The negations below exist so that "ignore the generated stuff" can
# never grow to eat the rows a reader came for.
results/*/trace/
results/*/state/
!results/*/stats/
!results/*/stats/coverage.json
!results/oneshots/
!results/oneshots/*.html
!results/oneshots/*.txt

# persistent Triton JIT cache for the container path (scripts/dual-up.sh mounts it)
.triton-cache/
# ad-hoc container tests without the persistent-cache mount create this sibling
.triton/

# editor swap files
*.swp
*.swo
*~
results/captured_request.pt

# The adaptive-expert demand database. The engine rewrites it after every request, so tracking it
# makes the tree permanently dirty and every commit carries a 244 KB binary diff. A fresh clone
# starts from the shipped routing trace (results/trace-union/stats/coverage.json) and rebuilds
# this within a few requests, which is the designed cold-start path.
results/prune_demand.npz
