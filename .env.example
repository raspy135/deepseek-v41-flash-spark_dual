# Local paths and API. Set credentials only in your private .env.
MODEL_DIR=/path/to/models/DeepSeek-V4.1-Flash
PYTHON=python3
SERVED_MODEL_NAME=deepseek
HOST=127.0.0.1
PORT=8000
MAX_SEQ=524288
SPEC=1
HF_TOKEN=
# Set the worker SSH address, head link IP, and link interface names.
# RoCE settings are detected separately on each node.
WORLD_SIZE=2
PEER=user@worker-ip
MASTER_ADDR=head-ip
MASTER_PORT=29611
NCCL_SOCKET_IFNAME=link-interface
GLOO_SOCKET_IFNAME=link-interface

# Expert memory budget, in GB per node.
ARENA_GB=88
DSV41_PREFILL_REPLICA_GB=0
DSV41_PREFILL_REPLICA_BUDGET_MS=500
PRUNE_KEEP=0.60
TRANSIENT_SLOTS=16
KEEP_FREE_GB=6
# Keep the checkpoint's native FP4 expert weights.
EXPERT_FORMAT=fp4
# Precision settings for normal serving.
DSV41_FP4_DOT_SCALED=0
DSV41_DENSE_FP4=off
# Prefill performance.
DSV41_PREFILL_FUSED_ATTN=1
DSV41_PREFILL_ATTN_BLOCK_H=16
DSV41_PREFILL_ATTN_BLOCK_N=32
DSV41_PREFILL_EP_OVERLAP=0
# 0 = off; 1 = capture the next request. Captures contain private prompt data.
DSV41_CAPTURE_NEXT=0
# Prefix caching. Disk budget is GB per node.
DSV41_PREFIX_SNAPSHOTS=8
DSV41_PREFIX_DISK=1
DSV41_PREFIX_DISK_GB=20
DSV41_PREFIX_DISK_STRICT=0

# Tensor parallelism across both nodes.
DSV41_TP_EXPERTS=1
DSV41_TP_DENSE=1
DSV41_TP_ATTN=1
DSV41_TP_HEAD=1
DSV41_TP_EXPERT_REDUCE=auto
DSV41_TP_EXPERT_LAYOUT=output
DSV41_TP_LINEAR_LAYOUT=output

# Adaptive expert loading.
DSV41_PRUNE_MISS=1
# Request-based demand. PRIOR and HALFLIFE are measured in requests.
DSV41_PRUNE_UNIT=request
DSV41_PRUNE_PRIOR=8
DSV41_PRUNE_DB=results/prune_demand_req.npz
DSV41_ENGRAM_ROW_SPLIT=1
# Enable expert swaps after requests.
DSV41_PRUNE_SWAP=1
DSV41_PRUNE_SWAP_MAX=512
DSV41_PRUNE_SWAP_MIN_GROWTH=0
DSV41_PRUNE_SWAP_MIN_GAIN=0.005
DSV41_PRUNE_SWAP_PREFILL=1
DSV41_PRUNE_SWAP_PREFILL_MIN=32
# Minimum prefill miss rate before swapping experts.
DSV41_PRUNE_SWAP_PREFILL_MIN_MISS=0.02
DSV41_PRUNE_HALFLIFE=20
# Peer keepalive interval, in seconds.
DSV41_EP_PING_S=30
# Image support.
DSV41_VISION=1
