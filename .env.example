# --- Model and API ---
# Checkpoint directory on each host; both nodes need a local copy.
MODEL_DIR=/path/to/models/DeepSeek-V4.1-Flash
# Python executable for native (non-container) launches.
PYTHON=python3
# Model name clients send in API requests.
SERVED_MODEL_NAME=deepseek
# Listen locally only; use a trusted interface IP for remote clients. No API auth.
HOST=127.0.0.1
PORT=8000
# Hugging Face download token, if needed. Never put a real token in this template.
HF_TOKEN=

# --- Context and generation ---
# Context capacity per active request, including its answer: 786432 = 768K tokens.
MAX_SEQ=786432
# Sparse attention entries per query (checkpoint: 512). Experimental; quality unmeasured.
# Restart both ranks together. Set 512 to restore checkpoint attention width.
DSV41_INDEX_TOPK=1024
# Enable speculative decoding with the checkpoint's draft model.
SPEC=1
# Acceptance-window depth 3/5 when confidence is disabled. Needs DSV41_MAX_CONCURRENCY=1.
# For fixed depth, set CONFIDENCE=0, remove DYNAMIC, and set DSV41_BLOCK=3.
DSV41_BLOCK_DYNAMIC=3,5
# Recipe default: per-step depth 1/3/5 from confidence and measured cost at every temperature.
# Sampling extends only a selected draft prefix; greedy uses whole-block lookahead.
# Requires DSV41_BLOCK=5 or unset. Set 0 to use adaptive 3/5 for every request.
DSV41_BLOCK_CONFIDENCE=1
# Optional CUDA graphs for prefill FFN blocks; attention/Engram stay eager.
# Requires resident FP4 TP, fixed routing and concurrency 1. See docs/prefill-cuda-graphs.md.
DSV41_PREFILL_GRAPHS=0
# Experimental: 2 batches concurrent requests on TP; needs extra cache memory.
DSV41_MAX_CONCURRENCY=1
# Image support.
DSV41_VISION=1

# --- Node networking ---
# Set the worker SSH address, head link IP, and link interface names.
# RoCE settings are detected separately on each node.
# Number of participating nodes; this profile requires two.
WORLD_SIZE=2
# Worker SSH destination, reachable from the head without a password prompt.
PEER=user@worker-ip
# Head node's IP on the direct node-to-node link.
MASTER_ADDR=head-ip
# Distributed rendezvous port, not the HTTP API port.
MASTER_PORT=29611
# Link interface used for GPU communication setup.
NCCL_SOCKET_IFNAME=link-interface
# Link interface used for coordination between nodes.
GLOO_SOCKET_IFNAME=link-interface
# Optional DGX Spark TP: dual rail for prefill, single rail for decode.
# Requires BOTH logical interfaces on the cabled port to have addresses (e.g.
# 10.0.0.1/24 + 10.0.1.1/24 on head; .2 on worker). See env.example for details.
# Validated with NCCL 2.29. Keep GID_INDEX unset for dynamic per-HCA selection.
# NCCL_IB_HCA=rocep1s0f1,roceP2p1s0f1
# NCCL_IB_ADDR_FAMILY=AF_INET
# NCCL_IB_ADDR_RANGE=10.0.0.0/23
# NCCL_IB_ROCE_VERSION_NUM=2
# NCCL_IB_MERGE_NICS=0
# NCCL_CROSS_NIC=0
# DSV41_PREFILL_DUAL_RAIL=1
# Peer keepalive interval, in seconds.
DSV41_EP_PING_S=30

# --- Expert memory ---
# Expert memory budget, in GB per node.
ARENA_GB=92
# Experimental prefill replicas; keep 0 with this TP profile.
DSV41_PREFILL_REPLICA_GB=0
# Replica preparation time budget in milliseconds; unused when replicas are off.
DSV41_PREFILL_REPLICA_BUDGET_MS=500
# Fraction of routed experts kept available; raise together with ARENA_GB.
PRUNE_KEEP=0.63
# Expert slots reserved for temporary streaming loads, outside the resident set.
TRANSIENT_SLOTS=16
# Minimum available-memory headroom required at arena allocation, in GB.
KEEP_FREE_GB=6

# --- Weight format and precision ---
# Keep the checkpoint's native FP4 expert weights.
EXPERT_FORMAT=fp4
# Experimental hardware FP4 arithmetic path; keep 0 for the validated profile.
DSV41_FP4_DOT_SCALED=0
# Native CUDA BM=16 decode kernel; enabled by default after graph microbenchmark tuning.
# Prefill and unsupported shapes continue through Triton; see docs/gotchas.md.
DSV41_FP4_CUDA=1
# Faster CUDA reduction order; set 0 for the original order. Restart both ranks together.
DSV41_FP4_CUDA_RELAXED=1
# Experimental batched sampled verification: one GPU result transfer, different seeded RNG.
# Default off pending end-to-end validation; see docs/spec-sampling.md. Set identically on both ranks.
DSV41_BATCHED_VERIFY=0
# Re-quantize the dense attention projections and wo_a to FP4 (`attn,wo_a`): about 7% off the decode
# step with the split-K kernel, at the quality cost docs/gotchas.md records. `off` reverts.
DSV41_DENSE_FP4=attn,wo_a
DSV41_FP4_DENSE_SPLIT=auto
# Hyper-Connection projection on the split-K fp32 kernel. Faster per STEP but not per SECOND -- its
# ~1e-6 arithmetic change lowers acceptance, so tok/s is a wash (docs/decode-fp32-experiments.md).
DSV41_HC_KERNEL=0
# Drafter head: off keeps the verifier's bf16 head. The fp8 draft copy (tier 1) was not in an A/B.
DSV41_DRAFT_HEAD_FMT=off
# Decode-sized all-gathers over the one-shot RoCE transport (tools/roce/): -5.5 ms/step, token hashes
# identical to NCCL (docs/decode-launches.md). Any setup failure falls back to NCCL by itself.
DSV41_COMM_BACKEND=roce
DSV41_ROCE_MAX_KB=256
DSV41_ROCE_HCAS=2
# error refuses at boot instead of falling back when the RoCE setup fails.
DSV41_ROCE_FALLBACK=nccl
# L2 prefetch of the next layer's weights during the MoE all-gather (~0.5-1 ms; 2 MB fits the window).
DSV41_L2PF_MB=2
# Optional: serve the abliterated attention output projection (layers 10-35) from a Keys overlay
# instead of the checkpoint's, applied at load -- no copy of the 510 GB tree, and the stock tree is
# never written (engine/ablit.py). The file is drowzeys/DeepSeek-V4.1-Flash-Abliterated-Cybersecurity-
# Unleashed's wo_b_l10_35.safetensors (~1.1 GB, the native fp8 e4m3 + e8m0 format), gated on HF:
# accept the terms on the model page, then `hf download`. Output-changing by design; every other
# tensor (experts, Engram, MTP/DSpark, vision) stays stock. Both ranks must point at the same file
# -- its digest is in the boot guard.
# DSV41_ABLIT_WOB=/home/ryan/dsv41-wo-b-ablit/wo_b_l10_35.safetensors
# Memoize the fp8->bf16 dequant on the prefill dense path. Bit-identical, but holds ~10 GiB on
# the 90 GB/keep 0.61 profile, so it is left off; enable only with the memory headroom.
DSV41_DENSE_DEQUANT_CACHE=0

# --- Prefill performance ---
# Tokens per chunk. 1024 gives finer cache boundaries; 2048 reduces dispatch overhead.
DSV41_PREFILL_CHUNK=1024
# Use the fused prefill attention implementation.
DSV41_PREFILL_FUSED_ATTN=1
# Attention kernel head tile size; leave at the tuned value.
DSV41_PREFILL_ATTN_BLOCK_H=16
# Attention kernel key tile size; leave at the tuned value.
DSV41_PREFILL_ATTN_BLOCK_N=32
# Experimental EP communication overlap; keep 0 with TP.
DSV41_PREFILL_EP_OVERLAP=0

# --- Decode performance ---
# Run the replicated shared expert on a side CUDA stream, overlapping routed experts.
DSV41_DECODE_SHARED_OVERLAP=1

# --- Prefix and context caching ---
# Chunk-boundary snapshots retained in addition to the full input boundary.
DSV41_PREFIX_SNAPSHOTS=16
# Save and restore matching prefixes across requests and server restarts.
DSV41_PREFIX_DISK=1
# Save at most once per five minutes; RAM prefixes still update every turn. 0 = every turn.
DSV41_PREFIX_DISK_MIN_INTERVAL_S=300
# Pack already-quantized history; window caches and index keys stay BF16.
DSV41_PACKED_KV=1
# Per-node disk cache limit in GB; least-recently-used bundles are evicted.
DSV41_PREFIX_DISK_GB=20
# 1 requires the same expert selection; 0 allows reuse after adaptation changes it.
DSV41_PREFIX_DISK_STRICT=0
# Prepare plain-text answers as prefixes after delivery; skips thinking/tools/vision.
DSV41_PREFIX_RESPONSE=1

# --- Tensor parallelism ---
# Split each resident routed expert across the two nodes.
DSV41_TP_EXPERTS=1
# Split main-model shared-expert weights across nodes.
DSV41_TP_DENSE=1
# Split attention projections across nodes; context caches remain replicated.
DSV41_TP_ATTN=1
# Split the output vocabulary projection across nodes.
DSV41_TP_HEAD=1
# Split draft experts, saving 3.36 GiB/node; required for the arena budget above.
DSV41_TP_DRAFT_EXPERTS=1
# Split input embeddings, saving 0.62 GiB/node; required for the arena budget above.
DSV41_TP_EMBED=1
# Automatic combine strategy for the legacy intermediate layout; leave at auto.
DSV41_TP_EXPERT_REDUCE=auto
# Preserve complete expert down-projection dot products; keep output for quality.
DSV41_TP_EXPERT_LAYOUT=output
# Preserve complete dense output-projection dot products; keep output for quality.
DSV41_TP_LINEAR_LAYOUT=output

# --- Adaptive expert loading ---
# How far one request moves the resident expert set: off, low, medium, high, max
# (demand half-life never / 40 / 20 / 10 / 5 requests), or a number in [0, 0.5).
# Higher follows a changing workload faster and swaps more experts per request; too high
# chases each prompt and raises the miss rate. Everything else is derived by the engine.
DSV41_ADAPT_SENSITIVITY=medium
# Weight of the shipped routing trace, in requests. Lower lets this server's traffic win sooner.
DSV41_ADAPT_PRIOR=8
# Mid-answer adaptation pass every N output tokens (~0.2 s each); 0 turns only these off.
# DSV41_ADAPT_DECODE_TOKENS=600
# Urgent decode-only miss check over the last ~30 output tokens: >10%, <=64 swaps,
# at least 150 tokens between attempts. 0 disables only this rolling trigger.
DSV41_ADAPT_URGENT=1
# Demand history file, kept across restarts; private. (Default shown.)
# DSV41_PRUNE_DB=results/prune_demand_req.npz

# --- Engram disk reads ---
# Divide Engram table reads between nodes to reduce duplicate disk work.
DSV41_ENGRAM_ROW_SPLIT=1
# Native C++ gather for decode-sized (<=384 row) reads instead of the Python pool.
# Measured ~+6% decode at 512 tokens on the development pair; needs the mmap row path
# (on by default). Roll back with 0 on both nodes and restart together.
DSV41_ENGRAM_NATIVE=1
# Packed Engram row cache, total MiB per node, divided across its two tables.
# Optional peer override permits more cache on the less busy node. Defaults off.
DSV41_ENGRAM_CACHE_MB=0
# DSV41_ENGRAM_CACHE_MB_PEER=4096

# --- Request capture ---
# 0 = off; 1 = capture the next request. Captures contain private prompt data.
DSV41_CAPTURE_NEXT=0
